# DriftGuard server configuration.
# Copy to .env and adjust. Every variable is optional in development.
# Full reference: docs/configuration.md

# --- Core ---------------------------------------------------------------
# development | production | test. Production refuses to start without a real secret key.
DRIFTGUARD_ENV=development

# Signs session tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
DRIFTGUARD_SECRET_KEY=

# SQLite (default) or PostgreSQL. postgres:// and postgresql:// URLs use the psycopg 3 driver.
DATABASE_URL=sqlite:///./driftguard.db
# DATABASE_URL=postgresql://driftguard:password@localhost:5432/driftguard

# Shared rate limits and realtime fan-out. Required when running more than one worker.
# REDIS_URL=redis://localhost:6379/0

# --- Accounts -----------------------------------------------------------
DRIFTGUARD_ALLOW_SIGNUP=true
DRIFTGUARD_SESSION_TTL_HOURS=168

# --- Rate limits (requests per minute) ----------------------------------
DRIFTGUARD_RATE_LIMIT_PER_MINUTE=300
DRIFTGUARD_INGEST_RATE_LIMIT_PER_MINUTE=600
DRIFTGUARD_LOGIN_RATE_LIMIT_PER_MINUTE=10

# --- Data handling ------------------------------------------------------
# Days to keep telemetry and resolved alerts. 0 disables pruning.
DRIFTGUARD_RETENTION_DAYS=30
DRIFTGUARD_RETENTION_INTERVAL_HOURS=6
# Redact secrets, emails, SSNs and card numbers from stored error messages and metadata.
DRIFTGUARD_SCRUB_PII=true
# Minutes before another alert is raised for the same drift root cause.
DRIFTGUARD_DRIFT_ALERT_COOLDOWN_MINUTES=15

# --- Notifications (critical alerts) ------------------------------------
# DRIFTGUARD_SLACK_WEBHOOK=https://hooks.slack.com/services/...
# DRIFTGUARD_ALERT_WEBHOOK=https://example.com/driftguard-alerts

# --- Serving ------------------------------------------------------------
# Defaults for the `driftguard-server` command (command-line flags override them).
# Use 0.0.0.0 to listen on all interfaces. Set REDIS_URL when running more than one worker.
# DRIFTGUARD_HOST=127.0.0.1
# PORT=8000
# DRIFTGUARD_WORKERS=1
# Comma-separated origins allowed to call the API from a browser on another origin.
# DRIFTGUARD_CORS_ORIGINS=https://dashboard.example.com
# Serve the dashboard from a custom directory instead of the packaged build.
# DRIFTGUARD_STATIC_DIR=
