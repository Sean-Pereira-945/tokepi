# DriftGuard environment configuration
# Copy this file to .env and fill in your values

# ------------------------------------------------------------------
# Database
# ------------------------------------------------------------------

# SQLite (local development / default)
DATABASE_URL=sqlite:///./driftguard.db

# PostgreSQL (production SaaS)
# DATABASE_URL=postgresql://user:password@host:5432/driftguard

# ------------------------------------------------------------------
# Security
# ------------------------------------------------------------------

# Secret key used internally for session token signing.
# ALWAYS override this in production with a strong random value.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
API_SECRET=driftguard-dev-secret-change-in-production

# ------------------------------------------------------------------
# Rate limiting
# ------------------------------------------------------------------

# Maximum number of API requests allowed per client IP per minute.
# Ingestion endpoint (/events/*) always allows up to 120 req/min.
RATE_LIMIT_PER_MINUTE=60
